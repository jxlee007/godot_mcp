{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jxlee007/godot-mcp",
  "title": "Godot MCP",
  "description": "Pure-Python FastMCP server for Godot 4 — 28 headless & animation tools. Runs via uvx.",
  "version": "1.0.4",
  "homepage": "https://github.com/jxlee007/godot_mcp",
  "repository": {
    "url": "https://github.com/jxlee007/godot_mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "godot-mcp-uvx",
      "version": "1.0.4",
      "runtime": "python",
      "runtimeVersion": ">=3.10",
      "transport": {
        "type": "stdio"
      },
      "installCommand": {
        "command": "uvx",
        "args": [
          "--from",
          "godot-mcp-uvx",
          "godot-mcp"
        ],
        "env": {
          "GODOT_PATH": {
            "description": "Absolute path to the Godot 4 executable (auto-detected from system PATH if not set)",
            "required": false
          },
          "DEBUG": {
            "description": "Set to 'true' to enable verbose stderr logging",
            "required": false,
            "default": "false"
          }
        }
      }
    }
  ],
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "sampling": false
  },
  "license": "MIT",
  "keywords": [
    "godot",
    "gamedev",
    "mcp",
    "ai",
    "python",
    "fastmcp",
    "animation",
    "cinematic"
  ]
}
